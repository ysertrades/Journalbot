# Required
DISCORD_TOKEN=your-bot-token
# Your Discord user id. The owner can always use /journal and /journal-settings. Comma separate for several.
OWNER_ID=
# Optional: register slash commands in one server instantly (recommended while testing)
GUILD_ID=
# Optional: where the SQLite file lives (default ./data/journal.sqlite). Point at a persistent volume when hosting.
JOURNAL_DB_PATH=
# Optional: 10 trace, 20 debug, 30 info
LOG_LEVEL=30

# ---------- Web journal and control panel (optional) ----------
# The port your host gives you (bot-hosting.net and most panels show it as SERVER_PORT; PORT also works). Default 3000.
SERVER_PORT=
# The public address of that port, exactly as visitors open it, no trailing slash: https://yourname.apps.bot-hosting.cloud
PUBLIC_BASE_URL=
# Discord Developer Portal -> your bot's application -> OAuth2. Add  <PUBLIC_BASE_URL>/auth/callback  under Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Any long random text; it signs logins. Changing it signs everyone out.
SESSION_SECRET=
# Let other sites frame the panel (Whop). Space separated. Leave empty to block all framing.
PANEL_FRAME_ANCESTORS=https://whop.com https://*.whop.com
# Optional: days a login lasts (default 30), 0 to turn the site off, and the address to listen on
WEB_SESSION_DAYS=30
WEB_ENABLED=1
HOST=0.0.0.0
